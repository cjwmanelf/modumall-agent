# 이 파일을 .env 로 복사하고 사용할 제공자의 키를 채우세요.

# 1. 활성 LLM 제공자 선택 (기본: openai | anthropic | google_genai | ollama)
MODU_LLM_PROVIDER=openai

# 2. 제공자별 API Key / URL 설정
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...
OLLAMA_BASE_URL=http://localhost:11434

# 3. 모델 지정 (선택 — 미입력 시 제공자별 권장 기본 모델 자동 적용)
# OpenAI 예시:
# MODU_MODEL=gpt-4o-mini
# MODU_ANSWER_MODEL=gpt-4o

# Anthropic Claude 예시:
# MODU_MODEL=claude-3-5-haiku-20241022
# MODU_ANSWER_MODEL=claude-3-7-sonnet-20250219

# Google Gemini 예시:
# MODU_MODEL=gemini-2.5-flash
# MODU_ANSWER_MODEL=gemini-2.5-pro

# 로컬 LLM (Ollama) 예시:
# MODU_MODEL=llama3.1
# MODU_ANSWER_MODEL=llama3.1
